rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 오늘 날짜(한국 시간)를 20261102 같은 숫자로
    function today() {
      let t = request.time + duration.value(9, 'h');
      return t.year() * 10000 + t.month() * 100 + t.day();
    }

    // 쓰기 권한: Google 로그인 계정, 또는 초대 코드로 가입한(members 문서가 있는) 이메일 계정
    function isMember() {
      return request.auth != null
        && (request.auth.token.firebase.sign_in_provider == 'google.com'
            || exists(/databases/$(database)/documents/members/$(request.auth.uid)));
    }

    // ---------- 초대 코드: invites/{코드} = { maxUses, uses } (운영자가 Firebase 콘솔에서 만듦) ----------
    // 로그인한 사람이 코드를 정확히 알 때만 읽을 수 있고(목록은 불가),
    // 가입하는 순간 같은 batch로 members 문서를 만들면서 사용 횟수를 1만 올릴 수 있습니다.
    match /invites/{code} {
      allow get: if request.auth != null;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses'])
        && request.resource.data.uses == resource.data.uses + 1
        && request.resource.data.uses <= resource.data.maxUses
        && !exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.code == code;
    }

    // ---------- 초대 가입 기록: members/{uid} = { code, joinedAt } ----------
    // 이메일 계정 본인이, 같은 batch에서 그 코드의 사용 횟수를 1 올릴 때만 만들 수 있습니다 (수정 불가).
    match /members/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.resource.data.keys().hasOnly(['code', 'joinedAt'])
        && request.resource.data.code is string
        && request.resource.data.joinedAt is number
        && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.uses
             == get(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.uses + 1;
    }

    // ---------- 하루 사용량: usage/{uid} = { day, chars, pubs } ----------
    // chars: 오늘 쓴 글자 수 (1만 자 이하), pubs: 오늘 공개한 메모 수 (2개 이하)
    // 본인만 읽고 쓸 수 있고, 오늘 날짜로만 기록하며, 같은 날 안에서는 줄일 수 없습니다(0으로 되돌리는 꼼수 방지).
    match /usage/{uid} {
      // 읽기와 삭제(회원 탈퇴)는 본인만
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid && isMember()
        && request.resource.data.keys().hasOnly(['day', 'chars', 'pubs'])
        && request.resource.data.day == today()
        && request.resource.data.chars is int
        && request.resource.data.chars <= 10000
        && request.resource.data.get('pubs', 0) is int
        && request.resource.data.get('pubs', 0) <= 2
        && (resource == null
            || resource.data.day != today()
            || (request.resource.data.chars >= resource.data.chars
                && request.resource.data.get('pubs', 0) >= resource.data.get('pubs', 0)));
    }

    // ---------- 프로필: profiles/{uid} = { name, visitCount, lastVisitAt, prevVisitAt } ----------
    // 본인만 읽고 쓰고 지울 수 있습니다. 이름은 비우거나(null = 기본값) 1~20자 문자열입니다.
    match /profiles/{uid} {
      function validProfile(d) {
        return d.keys().hasOnly(['name', 'visitCount', 'lastVisitAt', 'prevVisitAt'])
          && (d.get('name', null) == null
              || (d.name is string && d.name.size() >= 1 && d.name.size() <= 20))
          && d.get('visitCount', 0) is int
          && (d.get('lastVisitAt', null) == null || d.lastVisitAt is number)
          && (d.get('prevVisitAt', null) == null || d.prevVisitAt is number);
      }
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid && isMember()
        && validProfile(request.resource.data);
    }

    // ---------- 메모 ----------
    // 공개 메모는 누구나 읽을 수 있고, 비공개 메모는 작성자만 읽을 수 있습니다.
    // 쓰기(작성/수정/삭제)는 작성자 본인만 가능합니다.
    match /memos/{memoId} {
      function isOwner(data) {
        return request.auth != null && data.uid == request.auth.uid;
      }
      function isValid(data) {
        return data.content is string
          && data.content.size() <= 10000
          && data.isPublic is bool
          && data.authorName is string
          && data.authorName.size() <= 20
          && data.updatedAt is number;
      }
      // 새 메모: 정해진 필드만, 작성 시각은 지금 이전이어야 합니다
      // (미래 시각으로 써서 공개 목록 맨 위에 계속 머무르는 것을 막음. 휴대폰 시계 오차 10분까지 허용)
      function isValidNew(data) {
        return data.keys().hasOnly(['uid', 'authorName', 'content', 'isPublic', 'createdAt', 'updatedAt'])
          && data.createdAt is number
          && data.createdAt <= request.time.toMillis() + 600000;
      }
      // 수정: 바꿀 수 있는 필드는 내용·공개 여부·작성자 이름·수정 시각뿐입니다 (작성자, 작성 시각은 고정, 새 필드 추가 불가)
      function onlyEditableChanged() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['content', 'isPublic', 'authorName', 'updatedAt']);
      }
      function usagePath() {
        return /databases/$(database)/documents/usage/$(request.auth.uid);
      }
      // 이번 쓰기 전에 오늘 이미 쓴 글자 수
      function usedBefore() {
        return (exists(usagePath()) && get(usagePath()).data.day == today())
          ? get(usagePath()).data.chars : 0;
      }
      // 늘어난 글자 수(added)만큼 같은 쓰기 묶음(batch)에서 사용량이 정확히 늘었는지 확인합니다.
      // (사용량 문서 규칙이 1만 자를 넘지 못하게 막습니다)
      function charged(added) {
        return added <= 0
          || (getAfter(usagePath()).data.day == today()
              && getAfter(usagePath()).data.chars == usedBefore() + added);
      }
      // 이번 쓰기 전에 오늘 이미 공개한 메모 수
      function pubsBefore() {
        return (exists(usagePath()) && get(usagePath()).data.day == today())
          ? get(usagePath()).data.get('pubs', 0) : 0;
      }
      // 새로 공개되는 메모(공개로 새로 쓰기, 비공개→공개)는 같은 batch에서 공개 수가 정확히 1 늘어야 합니다
      // (사용량 문서 규칙이 하루 2개를 넘지 못하게 막습니다)
      function pubCharged(becomesPublic) {
        return !becomesPublic
          || (getAfter(usagePath()).data.day == today()
              && getAfter(usagePath()).data.get('pubs', 0) == pubsBefore() + 1);
      }

      allow read: if resource.data.isPublic == true || isOwner(resource.data);
      allow create: if isOwner(request.resource.data) && isMember()
        && isValid(request.resource.data)
        && isValidNew(request.resource.data)
        && charged(request.resource.data.content.size())
        && pubCharged(request.resource.data.isPublic == true);
      allow update: if isOwner(resource.data) && isMember()
        && onlyEditableChanged()
        && isValid(request.resource.data)
        && charged(request.resource.data.content.size() - resource.data.content.size())
        && pubCharged(request.resource.data.isPublic == true && resource.data.isPublic != true);
      allow delete: if isOwner(resource.data);
    }

    // 예전 저장 위치. 본인 읽기/삭제만 허용합니다.
    match /users/{uid}/memos/{memoId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
