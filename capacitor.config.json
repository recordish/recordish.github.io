{
  "appId": "com.recordish.app",
  "appName": "Recordish",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": false,
        "twitter": false
      }
    }
  },
  "server": {
    "url": "https://recordish.github.io",
    "allowNavigation": ["recordish.github.io"],
    "errorPath": "offline.html"
  }
}
